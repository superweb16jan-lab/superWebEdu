# ========================================================
# superWebSiksha - Lead Management Configuration (.env.local)
# ========================================================
# Copy this file to .env.local and fill in your credentials.

# --------------------------------------------------------
# 1. Google Sheets Integration (via Google Apps Script)
# --------------------------------------------------------
# Quick 2-Minute Setup:
# 1. Open your Google Sheet
# 2. Click "Extensions" > "Apps Script"
# 3. Paste the code from docs/google-sheet-script.js (or see instructions below)
# 4. Click "Deploy" > "New deployment" > Select type: "Web app"
#    - Execute as: "Me"
#    - Who has access: "Anyone"
# 5. Click "Deploy" and copy the Web App URL here:
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id_here/exec

# --------------------------------------------------------
# 2. Telegram Notification Settings
# --------------------------------------------------------
# Create a Telegram bot via @BotFather on Telegram:
# - Run /newbot and follow instructions to get your BOT TOKEN.
# - Add your bot to your channel/group or message it directly, then get your CHAT ID
#   (via @userinfobot or https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --------------------------------------------------------
# 3. Email SMTP Notification Settings (Nodemailer)
# --------------------------------------------------------
# If using Gmail:
# - Host: smtp.gmail.com
# - Port: 465 (secure) or 587
# - User: your_gmail_address@gmail.com
# - Pass: 16-character App Password (generate from Google Account > Security > 2-Step Verification > App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="superWebSiksha Admission Leads" <your_email@gmail.com>

# Where lead notifications should be delivered:
NOTIFICATION_EMAIL=your_counseling_desk_or_personal_email@gmail.com
